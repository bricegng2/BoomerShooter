<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Container" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); height: 1080px; max-height: 1080px; min-height: 1080px; max-width: 1920px; min-width: 1920px; width: 1920px; align-items: auto; align-self: center; justify-content: center; flex-direction: row;">
        <ui:VisualElement name="Stats" style="flex-grow: 0; flex-direction: row; align-self: center; align-items: center; flex-shrink: 0; justify-content: center; align-content: auto; position: absolute; right: auto; bottom: 30px; margin-bottom: 0; margin-right: 0; margin-top: 0; margin-left: 0;">
            <ui:VisualElement name="AmmoStuff" style="flex-grow: 0; width: 150px; align-items: center; align-self: auto; justify-content: center; flex-direction: column; position: relative; margin-left: 40px; margin-right: 40px; max-width: 150px; min-width: 150px; flex-shrink: 0; bottom: auto; left: auto;">
                <ui:Label text="999" name="AmmoNumber" style="height: auto; width: auto; font-size: 70px; align-items: center; justify-content: flex-start; align-self: center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; top: auto; bottom: auto; position: relative; align-content: auto; white-space: nowrap; -unity-text-align: middle-center; -unity-font-style: bold;"/>
                <ui:Label text="Ammo" name="AmmoText" style="font-size: 36px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-font-style: bold;"/>
            </ui:VisualElement>
            <ui:VisualElement name="HealthStuff" style="flex-grow: 1; width: 150px; align-items: center; align-self: center; justify-content: center; flex-direction: column; position: relative; margin-left: 40px; margin-right: 40px; max-width: 150px; min-width: 150px;">
                <ui:Label text="100" name="HealthNumber" style="height: auto; width: auto; font-size: 70px; align-items: center; justify-content: flex-start; align-self: center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; top: auto; bottom: auto; position: relative; align-content: auto; white-space: nowrap; -unity-text-align: middle-center; -unity-font-style: bold;"/>
                <ui:Label text="Health" name="HealthText" style="font-size: 36px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-font-style: bold;"/>
            </ui:VisualElement>
            <ui:VisualElement name="ArmourStuff" style="flex-grow: 1; width: 150px; align-items: center; align-self: center; justify-content: center; flex-direction: column; position: relative; margin-left: 40px; margin-right: 40px; max-width: 150px; min-width: 150px;">
                <ui:Label text="999" name="ArmourNumber" style="height: auto; width: auto; font-size: 70px; align-items: center; justify-content: flex-start; align-self: center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; top: auto; bottom: auto; position: relative; align-content: auto; white-space: nowrap; -unity-text-align: middle-center; -unity-font-style: bold;"/>
                <ui:Label text="Armour" name="ArmourText" style="font-size: 36px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-font-style: bold;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Keys" style="width: auto; min-width: auto; max-width: none; position: absolute; right: 55px; height: 129px; min-height: auto; max-height: none; top: auto; bottom: 30px; flex-direction: row; align-items: center; justify-content: center; align-self: auto; align-content: center; flex-shrink: 0;">
            <ui:VisualElement name="RedKey" style="flex-grow: 1; background-color: rgb(190, 56, 56); height: 66px; width: 66px; min-width: 66px; max-width: 66px; max-height: 66px; min-height: 66px; margin-top: 7px; margin-right: 7px; margin-bottom: 7px; margin-left: 7px; align-self: auto; justify-content: center;"/>
            <ui:VisualElement name="BlueKey" style="flex-grow: 1; background-color: rgb(45, 46, 185); width: 66px; min-width: 66px; max-width: 66px; height: 66px; min-height: 66px; max-height: 66px; margin-top: 7px; margin-right: 7px; margin-bottom: 7px; margin-left: 7px; align-content: flex-start; justify-content: center;"/>
            <ui:VisualElement name="YellowKey" style="flex-grow: 1; background-color: rgb(207, 184, 36); width: 66px; min-width: 66px; max-width: 66px; max-height: 66px; min-height: 66px; height: 66px; margin-top: 7px; margin-right: 7px; margin-bottom: 7px; margin-left: 7px; justify-content: center;"/>
        </ui:VisualElement>
        <ui:VisualElement name="Guns" style="flex-grow: 0; width: auto; min-width: auto; max-width: none; position: absolute; right: auto; height: 129px; min-height: auto; max-height: none; flex-direction: row; align-self: auto; align-items: center; top: auto; justify-content: center; align-content: center; left: 55px; bottom: 30px; flex-shrink: 0;">
            <ui:VisualElement name="PistolIcon" style="flex-grow: 1; background-color: rgb(242, 169, 0); height: 66px; width: 66px; min-width: 66px; max-width: 66px; max-height: 66px; min-height: 66px; margin-top: 7px; margin-right: 7px; margin-bottom: 7px; margin-left: 7px; align-self: auto; justify-content: center; align-content: flex-start;">
                <ui:Label text="1" style="-unity-text-align: upper-center; font-size: 47px; -unity-font-style: bold;"/>
            </ui:VisualElement>
            <ui:VisualElement name="MachineGunIcon" style="flex-grow: 1; background-color: rgb(242, 169, 0); width: 66px; min-width: 66px; max-width: 66px; height: 66px; min-height: 66px; max-height: 66px; margin-top: 7px; margin-right: 7px; margin-bottom: 7px; margin-left: 7px; top: auto; align-content: flex-start; justify-content: center;">
                <ui:Label text="2" style="-unity-text-align: upper-center; font-size: 47px; -unity-font-style: bold;"/>
            </ui:VisualElement>
            <ui:VisualElement name="ShotgunIcon" style="flex-grow: 1; background-color: rgb(242, 169, 0); width: 66px; min-width: 66px; max-width: 66px; max-height: 66px; min-height: 66px; height: 66px; margin-top: 7px; margin-right: 7px; margin-bottom: 7px; margin-left: 7px; top: auto; justify-content: center;">
                <ui:Label text="3" style="-unity-text-align: upper-center; font-size: 47px; -unity-font-style: bold;"/>
            </ui:VisualElement>
            <ui:VisualElement name="AcceleratorIcon" style="flex-grow: 1; background-color: rgb(242, 169, 0); width: 66px; min-width: 66px; max-width: 66px; max-height: 66px; min-height: 66px; height: 66px; margin-top: 7px; margin-right: 7px; margin-bottom: 7px; margin-left: 7px; top: auto; justify-content: center;">
                <ui:Label text="4" style="-unity-text-align: upper-center; font-size: 47px; -unity-font-style: bold;"/>
            </ui:VisualElement>
            <ui:VisualElement name="RocketLauncherIcon" style="flex-grow: 1; background-color: rgb(242, 169, 0); width: 66px; min-width: 66px; max-width: 66px; max-height: 66px; min-height: 66px; height: 66px; margin-top: 7px; margin-right: 7px; margin-bottom: 7px; margin-left: 7px; top: auto; justify-content: center;">
                <ui:Label text="5" style="-unity-text-align: upper-center; font-size: 47px; -unity-font-style: bold;"/>
            </ui:VisualElement>
            <ui:VisualElement name="GrenadeLauncherIcon" style="flex-grow: 1; background-color: rgb(242, 169, 0); width: 66px; min-width: 66px; max-width: 66px; max-height: 66px; min-height: 66px; height: 66px; margin-top: 7px; margin-right: 7px; margin-bottom: 7px; margin-left: 7px; top: auto; justify-content: center;">
                <ui:Label text="6" style="-unity-text-align: upper-center; font-size: 47px; -unity-font-style: bold;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Parry" style="flex-grow: 1; background-color: rgb(207, 184, 36); width: 76px; min-width: 76px; max-width: 76px; max-height: 76px; min-height: 76px; height: 76px; margin-top: 7px; margin-right: 7px; margin-bottom: 7px; margin-left: 7px; justify-content: center; right: 22%; position: absolute; bottom: 52px;">
            <ui:VisualElement name="CooldownOverlay" style="flex-grow: 1; position: absolute; width: 76px; min-width: 76px; max-width: 76px; height: 100%; min-height: 0%; max-height: 100%; background-color: rgba(106, 106, 106, 0.69); opacity: 1; top: auto; bottom: 0;"/>
            <ui:Label text="Q" name="Q" style="-unity-text-align: upper-center; font-size: 47px; -unity-font-style: bold;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
