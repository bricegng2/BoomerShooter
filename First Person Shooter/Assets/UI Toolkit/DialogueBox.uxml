<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Container" style="flex-grow: 0; align-items: center; align-self: center; width: 1000px; height: 470px; bottom: 82px; right: auto; position: absolute; top: auto; left: auto; background-color: rgb(94, 94, 94);">
        <ui:Label text="NPCName" name="NPCName" style="font-size: 55px; left: auto; top: auto; align-self: center; border-bottom-width: 4px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); margin-bottom: 0; padding-bottom: 0; align-items: flex-start; width: 100%; height: auto; margin-top: 0; margin-right: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-left: 0;"/>
        <ui:VisualElement name="TextContainer" style="align-self: stretch; flex-grow: 1; display: flex;">
            <ui:Label text="Hello, i am the boglin" name="DialogueText" enabled="true" style="font-size: 40px; -unity-font-style: normal; flex-wrap: wrap; white-space: normal; background-color: rgba(0, 0, 0, 0); align-self: center; width: 100%; height: 100%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; min-height: 100%; max-height: 100%; min-width: 100%; max-width: 100%;"/>
        </ui:VisualElement>
        <ui:VisualElement name="ChoiceContainer" style="align-self: stretch; flex-grow: 1; display: none;"/>
    </ui:VisualElement>
</ui:UXML>
